# ============================================================
# Local Experiment Cache & Heavy Directories
# ============================================================
# gnn-malware-detection contains 2.3GB of local graph caches & nested .git
gnn-malware-detection/

# ============================================================
# Large Binary Artifacts & Checkpoints
# ============================================================
*.pt
*.pth
*.ckpt
*.h5
*.pkl
*.pickle
*.gpickle
*.npy
*.npz

# Explicitly KEEP best_model.pt for zero-setup inference
!models/gnn/best_model.pt

# Ignore intermediate training checkpoints
models/**/checkpoint_*.pt

# ============================================================
# Data Caches (Generated by pipelines)
# ============================================================
data/graphs/
data/graphs_augmented/
data/embeddings/
data/embeddings_*
data/graphs_augmented_*

# Keep essential raw data & metadata
!data/raw/
!data/raw/**
!data/api_docs/
!data/api_docs/**
!data/splits/
!data/splits/**
!data/intermediate/
!data/intermediate/labels.json

# Benchmark local model caches
benchmarks/**/data/
benchmarks/**/models/*.pkl
benchmarks/**/models/*.pt

